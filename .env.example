# Required: Discord bot token. Keep the real value private in .env.
TOKEN=replace-with-your-discord-bot-token

# Optional IANA timezone used by environment-specific tooling.
# League scheduling defaults to America/New_York unless dynasty/database settings override it.
# DEFAULT_TIMEZONE=America/Chicago

# Optional comma-separated Discord role names used by BLACKLINE access checks.
# DYNASTY_MANAGER_ROLES=Commissioner,Dynasty Manager,League Manager
# BL_STAFF_ROLES=BL Staff

# Website integration (set these only in the private server environment)
# Discord Developer Portal OAuth2 redirect URI must exactly match DISCORD_REDIRECT_URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3030/auth/callback
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs. Use IDs, not role names.
BLACKLINE_STAFF_ROLE_IDS=
BLACKLINE_MANAGER_ROLE_IDS=
# Optional overrides for the website when the bot data directory differs.
# DYNASTY_DATA_PATH=
# WEBSITE_REQUESTS_PATH=
# WEBSITE_AUDIT_PATH=
# WEBSITE_ACTIONS_PATH=

# Optional: Discord text channel ID for team claim/release/repair notifications. Leave blank to disable.
TEAM_CLAIM_NOTIFICATION_CHANNEL_ID=

# Optional per-event switches for team claim announcements. Defaults are enabled
# when a notification channel is configured. Set any value to false to disable it.
# TEAM_CLAIM_NOTIFY_CLAIMS=true
# TEAM_CLAIM_NOTIFY_RELEASES=true
# TEAM_CLAIM_NOTIFY_REPAIRS=true

# Optional Twitch member account linking (Fix 169). Register this exact callback URL in the Twitch Developer Console.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_OAUTH_REDIRECT_URI=http://localhost:3030/auth/twitch/callback
# WEBSITE_TWITCH_LINKS_PATH=  # Optional path for private persisted link records

# Fix 170: persistent Discord Creator Connections panel target.
# Bot updates an existing BLACKLINE panel or posts one in this channel on startup.
BLACKLINE_WEBSITE_URL=https://your-blackline-website.example
CREATOR_CONNECTIONS_CHANNEL_NAME=🎥・media
